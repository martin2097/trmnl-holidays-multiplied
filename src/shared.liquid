              <rect x="{{ x }}" y="{{ top }}" width="{{ tile }}" height="{{ tile }}" rx="1" fill="{% if day.style == 'leave' %}black{% elsif day.style == 'holiday' %}url(#pto-adapt-holiday-lines-{{ scope }}){% else %}url(#pto-adapt-weekend-dots-{{ scope }}){% endif %}" stroke="black" stroke-width="1.2"/>
              <text {% unless day.style == 'leave' %}class="text-stroke text-stroke--large text-stroke--white"{% endunless %} x="{{ cx }}" y="{{ cy | plus: numeral_offset }}" fill="{% if day.style == 'leave' %}white{% else %}black{% endif %}" font-family="Inter,Arial,sans-serif" font-size="{{ numeral }}" font-weight="700" text-anchor="middle">{{ day.day }}</text>
              <text x="{{ cx }}" y="{{ top | plus: tile | plus: caption_offset }}" fill="black" font-family="Inter,Arial,sans-serif" font-size="{{ caption_size }}" text-anchor="middle">{% if day.style == 'leave' %}Take off{% elsif day.style == 'holiday' %}Holiday{% else %}Weekend{% endif %}</text>
            {% endfor %}
