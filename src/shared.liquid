    </div>
    <div class="col--span-7 flex flex--col flex--stretch-x {% if tickets.size >= 5 %}gap--space-between{% else %}gap--small{% endif %} pl--3">
      <div class="flex flex--row flex--left pb--1 no-shrink"><span class="label text--bold">YOUR NEXT ESCAPES</span></div>
      {% for card in tickets %}
        {% assign ticket_action_size = card.request_label.size | plus: card.break_label.size %}
        {% assign paid_pto = false %}{% if card.status == 'available' and card.leave_cost > 0 %}{% assign paid_pto = true %}{% endif %}
        <div class="relative w--full {% if dense_world and ticket_action_size <= 40 %}h--12{% else %}h--14{% endif %} no-shrink">
          <svg class="absolute inset--0 w--full h--full" viewBox="0 0 400 56" preserveAspectRatio="none" aria-hidden="true">
            {% unless paid_pto %}<defs><pattern id="ticket-fill-{{ forloop.index }}" width="6" height="6" patternUnits="userSpaceOnUse"><rect width="6" height="6" fill="white"/>{% if card.status == 'weekend' %}<circle cx="2" cy="2" r="0.7" fill="black"/>{% else %}<path d="M0 6L6 0M-1 1L1-1M5 7L7 5" stroke="black" stroke-width="0.7"/>{% endif %}</pattern></defs>{% endunless %}
            <path d="M8 1H394Q399 1 399 6V50Q399 55 394 55H8Q1 55 1 48V34a6 6 0 0 0 0-12V8Q1 1 8 1Z" fill="white" stroke="black" stroke-width="1" vector-effect="non-scaling-stroke"/>
            <path d="M8 2H64V54H8Q2 54 2 48V34a6 6 0 0 0 0-12V8Q2 2 8 2Z" fill="{% if paid_pto %}black{% else %}url(#ticket-fill-{{ forloop.index }}){% endif %}"/>
            <path d="M{% if paid_pto %}61{% else %}64{% endif %} 3V53" stroke="{% if paid_pto %}white{% else %}black{% endif %}" stroke-dasharray="2 3" vector-effect="non-scaling-stroke"/>
          </svg>
          <div class="relative grid grid--cols-12 gap--small w--full h--full px--1">
          <div class="col--span-2 flex flex--col flex--center gap--none" role="img" aria-label="{% if card.status == 'weekend' %}Weekend holiday{% elsif card.status == 'day' %}Holiday day off{% else %}Use {{ card.leave_cost }} {% if card.leave_cost == 1 %}day{% else %}days{% endif %} of leave{% endif %}">
              {% if card.status == 'weekend' %}
                <span class="label text--bold text-stroke text-stroke--medium text-stroke--white">OH</span><span class="label text--bold text-stroke text-stroke--medium text-stroke--white">NO</span>
              {% elsif card.status == 'day' %}
                <span class="label label--small text--bold text-stroke text-stroke--medium text-stroke--white">DAY</span><span class="label label--small text--bold text-stroke text-stroke--medium text-stroke--white">OFF</span>
              {% else %}
                <span class="label label--small text--bold {% if paid_pto %}text--white{% else %}text-stroke text-stroke--medium text-stroke--white{% endif %}">USE</span>
                <span class="value value--small text--bold {% if paid_pto %}text--white{% else %}text-stroke text-stroke--large text-stroke--white{% endif %}" data-use-count>{{ card.leave_cost }}<span class="label label--small text--regular {% if paid_pto %}text--white{% else %}text-stroke text-stroke--medium text-stroke--white{% endif %}">&nbsp;{% if card.leave_cost == 1 %}day{% else %}days{% endif %}</span></span>
              {% endif %}
          </div>
          <div class="col--span-8 flex flex--col flex--left flex--center-y gap--none pr--1">
            {% if card.status == 'available' %}
              <span class="label pto-ticket-heading {% if card.title.size > 38 or dense_world or ticket_action_size > 40 %}label--small{% endif %} text--regular w--full" data-ticket-heading><span class="text--bold">{{ card.title | escape }}</span> &middot; <span class="text--regular pto-ticket-countdown">{{ card.countdown_label | escape }}</span></span>
              <span class="label label--small text--regular w--full">{% if card.leave_cost == 0 %}No leave needed{% else %}Take {{ card.request_label | escape }}{% endif %} &rarr; {{ card.break_label | escape }} Off</span>
            {% else %}
              <span class="label pto-ticket-heading {% if card.title.size > 38 or dense_world %}label--small{% endif %} text--regular w--full" data-ticket-heading><span class="text--bold">{{ card.title | escape }}</span> &middot; <span class="text--regular pto-ticket-countdown">{{ card.countdown_label | escape }}</span></span>
              <span class="label label--small text--regular w--full">{{ card.weekend_line | escape }}</span>
            {% endif %}
          </div>
          <div class="col--span-2 flex flex--col flex--center gap--none pl--1">
            {% if card.status == 'weekend' %}<span class="value value--xsmall text--bold">0</span><span class="label label--small text--center">extra days</span>{% else %}<span class="value value--small text--bold">{{ card.total_days }}</span><span class="label label--small">{% if card.total_days == 1 %}day off{% else %}days off{% endif %}</span>{% endif %}
          </div>
          </div>
        </div>
      {% endfor %}
      {% if tickets.size == 0 %}<span class="label label--small">{% if status == 'partial' %}Waiting for more published dates.{% else %}No upcoming national dates listed.{% endif %}</span>{% endif %}
    </div>
  </div>
  <div class="grid grid--cols-12 gap--medium w--full bg--gray-75 rounded--small p--2 no-shrink">
    <div class="col--span-5 flex flex--row flex--left flex--center-y gap--small">
      <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true" class="no-shrink"><circle cx="20" cy="20" r="18.5" fill="white" stroke="black" stroke-width="1.2"/><path d="m9 6 6-3 4 2 1 4-5 2-2 5-4 1-1 5-4-5 1-6Zm6 14 6 1 4 5-3 3-2 7-4-4-2-6Zm10-16 6 4 2 4-5 1-2 4 5 3 5-1 2 7-5 4-5-3-2-5-4-1 1-5-3-3 2-4Z" fill="black"/></svg>
      <div class="flex flex--col flex--left gap--none">
        <span class="label label--small">SOMEWHERE, IT'S A HOLIDAY.</span>
        <span class="label {% if world.location_label.size > 32 %}label--small{% endif %} text--bold">{{ world.location_label | escape }}</span>
        <span class="label label--small text--regular">{{ world.name | escape }}</span>
      </div>
    </div>
    <div class="col--span-7 flex flex--col flex--left flex--center-y gap--xsmall pl--1">
      <span class="label label--small text--bold">{{ world.headline | escape }}</span>
      {% if world.source_note != blank %}<span class="label label--small text--regular">{{ world.source_note | escape }}</span>{% endif %}
    </div>
  </div>
{% endif %}
</div>
{% render "pto_footer" %}
{% endtemplate %}

<script>
(function () {
  function alignOrientation() {
    var screen = document.querySelector('.screen--lg');
    if (!screen || screen.classList.contains('screen--portrait')) return;
    var rect = screen.getBoundingClientRect();
    var view = document.querySelector('[data-pto-view]');
    var shape = view ? view.getAttribute('data-pto-view') : 'full';
    var width = rect.width * (shape === 'half_vertical' ? 2 : 1);
    var height = rect.height * (shape === 'half_horizontal' ? 2 : 1);
    if (height > width) screen.classList.add('screen--portrait');
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', alignOrientation);
  else alignOrientation();
})();
</script>
