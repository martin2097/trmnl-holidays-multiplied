{% comment %}Reusable master components. Shared only defines partials; OG full renders its original markup.{% endcomment %}
{% template pto_identity %}
  {% assign date_heading = hero.holiday_date | date: '%-d %B, %A' %}
  <div class="flex flex--col flex--left gap--none w--full no-shrink">
    <span class="label label--small {% if profile == 'full' or profile == 'full_portrait' %}lg:label--base{% endif %}">YOUR NEXT HOLIDAY</span>
    <span class="{% if profile == 'banner' %}label label--large lg:title lg:title--base{% else %}title {% if profile == 'column' %}title--large lg:title--base lg:portrait:title--xlarge{% elsif profile == 'full' or profile == 'full_portrait' %}lg:title--xlarge{% elsif profile == 'quadrant' %}lg:title--base lg:portrait:title--base{% else %}lg:title--base{% endif %}{% endif %} text--bold w--full">{% if hero.holiday_date %}{% if profile == 'quadrant' %}{{ hero.holiday_date | date: '%-d %b' }} &middot; {{ hero.weekday }}{% else %}{{ date_heading }}{% endif %}{% else %}More good days ahead{% endif %}</span>
    {% unless hide_name %}<span class="label {% if profile == 'quadrant' or hero.name.size > 48 %}label--small{% endif %} {% if profile == 'full' or profile == 'full_portrait' %}lg:label--large{% else %}lg:label--base{% endif %} text--regular w--full">{{ hero.name | escape }}</span>{% endunless %}
  </div>
{% endtemplate %}
{% template pto_countdown %}
  <div class="flex flex--row flex--left flex--center-y gap--small no-shrink">
    {% if hero.days_until > 0 %}<span class="value {% if compact_countdown %}value--base{% elsif profile == 'full' or profile == 'full_portrait' %}value--large lg:value--xxlarge{% elsif profile == 'column' %}value--large lg:portrait:value--xxlarge{% elsif profile == 'quadrant' %}value--base lg:value--large lg:portrait:value--xlarge{% else %}value--large{% endif %} text--bold">{{ hero.days_until }}</span><span class="label {% unless profile == 'full' or profile == 'full_portrait' %}label--small{% else %}lg:label--large{% endunless %}">{% if hero.days_until == 1 %}day{% else %}days{% endif %}<br>to go</span>
    {% elsif hero.days_until == 0 %}<span class="value {% if profile == 'full' or profile == 'full_portrait' %}value--large lg:value--xlarge{% else %}value--base lg:value--large{% endif %} text--bold">Today</span>{% endif %}
  </div>
{% endtemplate %}
{% template pto_action %}
  <div class="flex flex--col flex--left gap--none w--full no-shrink">
    <span class="{% if profile == 'banner' %}label label--large lg:title lg:title--base{% else %}title {% if profile == 'column' %}title--large lg:title--base lg:portrait:title--large{% elsif profile == 'full' or profile == 'full_portrait' %}lg:title--xlarge{% elsif profile == 'quadrant' %}title--small lg:title--base lg:portrait:title--base{% else %}lg:title--base{% endif %}{% endif %} text--bold">{{ hero.headline | escape }}</span>
    {% if hero.status == 'bridge' %}<span class="label {% if profile == 'quadrant' or profile == 'banner' %}label--small{% endif %} {% if profile == 'full' or profile == 'full_portrait' %}lg:label--large{% else %}lg:label--base{% endif %} text--regular w--full">Take {{ hero.request_label | escape }} &rarr; {{ hero.break_label | escape }} Off</span>
    {% elsif hero.status == 'natural' %}<span class="label {% if profile == 'quadrant' or profile == 'banner' %}label--small{% endif %} {% if profile == 'full' or profile == 'full_portrait' %}lg:label--large{% else %}lg:label--base{% endif %} text--regular w--full">No leave needed &rarr; {{ hero.break_label | escape }} Off</span>
    {% else %}<span class="label {% if profile == 'quadrant' or profile == 'banner' %}label--small{% endif %} {% if profile == 'full' or profile == 'full_portrait' %}lg:label--large{% else %}lg:label--base{% endif %} text--regular w--full">{{ hero.story | escape }}</span>{% endif %}
    {% if hero.observed_label != blank %}<span class="label label--small">{{ hero.observed_label | escape }}</span>{% endif %}
  </div>
{% endtemplate %}
{% template pto_calendar %}
        {% assign count = hero.timeline.size %}
        {% if count > 0 %}
          {% assign canvas_width = 320 %}
          {% assign tile = 52 %}{% assign gap = 8 %}{% assign numeral = 34 %}
          {% assign row_count = count %}
          {% assign image_height = 118 %}{% assign bracket_y = 96 %}{% assign row_step = 76 %}
          {% if compact %}{% assign image_height = 108 %}{% assign bracket_y = 86 %}{% endif %}
          {% if count > 5 %}
            {% assign tile = 44 %}{% assign gap = 14 %}{% assign numeral = 29 %}
            {% assign row_count = count | plus: 1 | divided_by: 2 | floor %}
            {% assign image_height = 202 %}{% assign bracket_y = 180 %}{% assign row_step = 82 %}
            {% if compact %}{% assign image_height = 196 %}{% assign bracket_y = 174 %}{% endif %}
          {% endif %}
          {% if profile == 'full' %}{% assign canvas_width = 300 %}{% if count <= 5 %}{% assign tile = 56 %}{% assign gap = 4 %}{% assign image_height = 122 %}{% assign bracket_y = 100 %}{% endif %}{% endif %}
          {% if profile == 'banner' %}{% assign canvas_width = 340 %}{% if count > 5 %}{% assign canvas_width = 360 %}{% endif %}{% endif %}
          {% if profile == 'banner_portrait' and count <= 5 %}{% assign canvas_width = 300 %}{% endif %}
          {% if profile == 'full_portrait' %}
            {% assign canvas_width = 360 %}{% if compact %}{% assign canvas_width = 380 %}{% endif %}{% assign gap = 14 %}
            {% if count > 5 %}{% assign canvas_width = 520 %}{% assign tile = 48 %}{% assign numeral = 32 %}{% endif %}
          {% endif %}
          {% assign step = tile | plus: gap %}
          {% assign width = row_count | times: step | minus: gap %}
          {% assign offset = canvas_width | minus: width | divided_by: 2 %}
          {% assign middle = tile | divided_by: 2 %}
          <svg class="block w--full h--auto" data-pto-calendar width="{{ canvas_width }}" height="{{ image_height }}" viewBox="0 0 {{ canvas_width }} {{ image_height }}" role="img" aria-label="{% if hero.status == 'weekend' %}{{ hero.name | escape }} falls inside your weekend{% else %}{{ hero.total_days }} consecutive days off; use {{ hero.leave_cost }} days of leave{% endif %}">
            <defs>
              <pattern id="pto-adapt-weekend-dots-{{ scope }}" width="6" height="6" patternUnits="userSpaceOnUse"><rect width="6" height="6" fill="white"/><circle cx="2" cy="2" r="1" fill="black"/></pattern>
              <pattern id="pto-adapt-holiday-lines-{{ scope }}" width="6" height="6" patternUnits="userSpaceOnUse"><rect width="6" height="6" fill="white"/><path d="M-1 1L1-1M0 6L6 0M5 7L7 5" stroke="black" stroke-width="1"/></pattern>
            </defs>
            {% for day in hero.timeline %}
              {% assign row = forloop.index0 | divided_by: row_count | floor %}
              {% assign column = forloop.index0 | modulo: row_count %}
              {% assign this_offset = offset %}
              {% if row == 1 %}{% assign last_count = count | minus: row_count %}{% assign last_width = last_count | times: step | minus: gap %}{% assign this_offset = canvas_width | minus: last_width | divided_by: 2 %}{% endif %}
              {% assign row_y = row | times: row_step %}
              {% assign x = column | times: step | plus: this_offset %}
              {% assign cx = x | plus: middle %}
              {% assign top = row_y | plus: 20 %}{% if compact %}{% assign top = row_y | plus: 14 %}{% endif %}
              {% assign cy = middle | plus: top %}
              <text x="{{ cx }}" y="{{ top | minus: 6 }}" fill="black" font-family="Inter,Arial,sans-serif" font-size="11" font-weight="600" text-anchor="middle">{{ day.weekday | upcase | escape }}</text>
              <rect x="{{ x }}" y="{{ top }}" width="{{ tile }}" height="{{ tile }}" rx="1" fill="{% if day.style == 'leave' %}black{% elsif day.style == 'holiday' %}url(#pto-adapt-holiday-lines-{{ scope }}){% else %}url(#pto-adapt-weekend-dots-{{ scope }}){% endif %}" stroke="black" stroke-width="1.2"/>
              <text {% unless day.style == 'leave' %}class="text-stroke text-stroke--large text-stroke--white"{% endunless %} x="{{ cx }}" y="{{ cy | plus: 9 }}" fill="{% if day.style == 'leave' %}white{% else %}black{% endif %}" font-family="Inter,Arial,sans-serif" font-size="{{ numeral }}" font-weight="700" text-anchor="middle">{{ day.day }}</text>
              <text x="{{ cx }}" y="{{ top | plus: tile | plus: 13 }}" fill="black" font-family="Inter,Arial,sans-serif" font-size="11" text-anchor="middle">{% if day.style == 'leave' %}Take off{% elsif day.style == 'holiday' %}Holiday{% else %}Weekend{% endif %}</text>
            {% endfor %}
            {% assign right = offset | plus: width %}
            <path d="M{{ offset }} {{ bracket_y | minus: 6 }}v6H{{ right }}v-6" fill="none" stroke="black" stroke-width="1.2"/>
            <text x="{{ canvas_width | divided_by: 2 }}" y="{{ bracket_y | plus: 17 }}" fill="black" font-family="Inter,Arial,sans-serif" font-size="12" text-anchor="middle">{% if hero.status == 'weekend' %}A holiday, but no extra day off.{% else %}<tspan font-weight="700">{{ hero.total_days }} days</tspan> to yourself.{% endif %}</text>
          </svg>
        {% endif %}

{% endtemplate %}
{% template pto_hero %}
  <div class="flex flex--col flex--stretch-x gap--space-between h--full w--full" data-pto-hero>
    {% assign wide_name = false %}{% if profile == 'banner' and hero.name.size > 28 %}{% assign wide_name = true %}{% endif %}
    {% if side_countdown %}<div class="flex flex--col gap--none w--full no-shrink {% if portrait_stack %}lg:portrait:hidden{% endif %}"><div class="grid grid--cols-12 gap--small w--full"><div class="col--span-8">{% render "pto_identity", hero: hero, profile: profile, hide_name: wide_name %}</div><div class="col--span-4 flex flex--right flex--center-y">{% render "pto_countdown", hero: hero, profile: profile, compact_countdown: wide_name %}</div></div>{% if wide_name %}<span class="label {% if hero.name.size > 48 %}label--small{% endif %} text--regular w--full">{{ hero.name | escape }}</span>{% endif %}</div>
    {% if portrait_stack %}<div class="md:hidden lg:portrait:flex flex--col flex--left gap--small w--full no-shrink">{% render "pto_identity", hero: hero, profile: profile %}{% render "pto_countdown", hero: hero, profile: profile %}</div>{% endif %}
    {% else %}<div class="flex flex--col flex--left gap--xsmall w--full no-shrink">{% render "pto_identity", hero: hero, profile: profile %}{% render "pto_countdown", hero: hero, profile: profile %}</div>{% endif %}
    {% render "pto_action", hero: hero, profile: profile %}
    {% if show_calendar %}<div class="{% if profile == 'quadrant' and small_calendar == false %}md:hidden lg:flex{% else %}flex{% endif %} flex--center w--full no-shrink"><div class="{% if profile == 'full' or profile == 'full_portrait' %}w--full{% elsif profile == 'quadrant' %}{% if hero.timeline.size > 5 %}w--72 lg:w--80 lg:portrait:w--72{% else %}{% if hero.observed_label != blank %}w--64{% else %}w--72{% endif %} {% if hero.observed_label != blank or world_long_name %}lg:w--80{% else %}lg:w--96{% endif %} lg:portrait:w--full{% endif %}{% elsif profile == 'column' %}{% if hero.timeline.size > 5 %}w--72 lg:w--64 lg:portrait:w--72{% else %}w--full lg:w--96 lg:portrait:w--full{% endif %}{% else %}{% if hero.timeline.size > 5 %}w--64 lg:portrait:w--72{% else %}w--full{% endif %}{% endif %} w--max-full">{% if profile == 'banner' %}<div class="lg:portrait:hidden">{% render "pto_calendar", hero: hero, compact: compact_calendar, profile: profile, scope: scope %}</div>{% assign portrait_scope = scope | append: '-portrait' %}<div class="md:hidden lg:portrait:block">{% render "pto_calendar", hero: hero, compact: compact_calendar, profile: "banner_portrait", scope: portrait_scope %}</div>{% else %}{% render "pto_calendar", hero: hero, compact: compact_calendar, profile: profile, scope: scope %}{% endif %}</div></div>{% endif %}
  </div>
{% endtemplate %}
{% template pto_world %}
  {% if world.name != blank %}
  <div class="{% if stacked %}flex flex--col gap--xsmall{% else %}grid grid--cols-12 gap--small{% endif %} w--full bg--gray-75 rounded--small {% if large %}p--3{% elsif slim %}p--1{% elsif tight %}p--1 lg:portrait:p--2{% else %}p--2{% endif %} no-shrink" data-pto-world>
    <div class="{% unless stacked %}{% if compact %}col--span-7{% else %}col--span-5 lg:portrait:col--span-7{% endif %}{% endunless %} flex flex--row flex--left flex--center-y gap--small">
      <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true" class="{% if large %}lg:w--20 lg:h--20{% elsif slim %}w--6 h--6{% elsif compact %}w--8 h--8 lg:w--12 lg:h--12{% endif %} no-shrink"><circle cx="20" cy="20" r="18.5" fill="white" stroke="black" stroke-width="1.2"/><path d="m9 6 6-3 4 2 1 4-5 2-2 5-4 1-1 5-4-5 1-6Zm6 14 6 1 4 5-3 3-2 7-4-4-2-6Zm10-16 6 4 2 4-5 1-2 4 5 3 5-1 2 7-5 4-5-3-2-5-4-1 1-5-3-3 2-4Z" fill="black"/></svg>
      <div class="flex flex--col flex--left gap--none grow">
        <span class="label label--small {% if compact %}md:hidden lg:block{% endif %} {% if large %}lg:label--base{% endif %}">SOMEWHERE, IT'S A HOLIDAY.</span>
        <span class="label {% if compact %}label--small lg:label--base{% endif %} {% if large %}lg:label--large{% endif %} text--bold">{{ world.location_label | escape }}</span>
        <span class="label label--small {% if large %}lg:label--base{% endif %} text--regular">{{ world.name | escape }}</span>
      </div>
    </div>
    <div class="{% unless stacked %}{% if compact %}col--span-5{% else %}col--span-7 lg:portrait:col--span-5{% endif %}{% endunless %} flex flex--col flex--left flex--center-y gap--none">
      <span class="label label--small {% if large %}lg:label--base{% endif %} text--bold">{{ world.headline | escape }}</span>
      {% if world.source_note != blank %}<span class="label label--small text--regular">{{ world.source_note | escape }}</span>{% endif %}
    </div>
  </div>
  {% endif %}
{% endtemplate %}
{% template pto_tickets %}
  {% assign long_actions = 0 %}{% for card in tickets limit: 5 %}{% assign action_size = card.request_label.size | plus: card.break_label.size %}{% if action_size > 40 %}{% assign long_actions = long_actions | plus: 1 %}{% endif %}{% endfor %}
<style>
  .trmnl .pto-ticket-heading {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .trmnl .pto-ticket-countdown {
    font-size: 0.9em;
  }
</style>
  <div class="flex flex--col flex--stretch-x {% if profile == 'banner' %}gap--space-between lg:portrait:gap--small{% elsif profile == 'column' and long_actions > 2 %}gap--xsmall{% else %}gap--small{% endif %} {% if profile == 'full' %}lg:gap--space-between lg:portrait:gap--small{% endif %} w--full {% if distributed %}h--full{% else %}h--auto{% endif %}" data-pto-tickets>
    <span class="label {% if profile == 'full' %}lg:label--large{% else %}lg:label--base{% endif %} text--bold no-shrink">YOUR NEXT ESCAPES</span>
    {% assign ticket_count = ticket_limit | default: 5 %}
    {% for card in tickets limit: ticket_count %}
      {% assign ticket_action_size = card.request_label.size | plus: card.break_label.size %}
      {% assign paid_pto = false %}{% if card.status == 'available' and card.leave_cost > 0 %}{% assign paid_pto = true %}{% endif %}
      <div class="relative w--full {% if profile == 'full' %}h--20 lg:h--24 {% if ticket_action_size > 40 %}lg:portrait:h--20{% else %}lg:portrait:h--16{% endif %}{% elsif profile == 'column' %}h--auto{% elsif spacious %}h--14{% else %}h--11 lg:portrait:h--16{% endif %} no-shrink" data-pto-ticket>
          <svg class="absolute inset--0 w--full h--full" viewBox="0 0 400 56" preserveAspectRatio="none" aria-hidden="true">
            {% unless paid_pto %}<defs><pattern id="pto-adapt-ticket-fill-{{ scope }}-{{ forloop.index }}" width="6" height="6" patternUnits="userSpaceOnUse"><rect width="6" height="6" fill="white"/>{% if card.status == 'weekend' %}<circle cx="2" cy="2" r="0.7" fill="black"/>{% else %}<path d="M0 6L6 0M-1 1L1-1M5 7L7 5" stroke="black" stroke-width="0.7"/>{% endif %}</pattern></defs>{% endunless %}
            <path d="M8 1H394Q399 1 399 6V50Q399 55 394 55H8Q1 55 1 48V34a6 6 0 0 0 0-12V8Q1 1 8 1Z" fill="white" stroke="black" stroke-width="1" vector-effect="non-scaling-stroke"/>
            <path d="M8 2H64V54H8Q2 54 2 48V34a6 6 0 0 0 0-12V8Q2 2 8 2Z" fill="{% if paid_pto %}black{% else %}url(#pto-adapt-ticket-fill-{{ scope }}-{{ forloop.index }}){% endif %}"/>
            <path d="M{% if paid_pto %}61{% else %}64{% endif %} 3V53" stroke="{% if paid_pto %}white{% else %}black{% endif %}" stroke-dasharray="2 3" vector-effect="non-scaling-stroke"/>
          </svg>

        <div class="relative grid grid--cols-12 gap--small w--full {% if profile == 'column' %}h--auto h--min-14 lg:portrait:h--min-16{% else %}h--full{% endif %} px--1">
          <div class="col--span-2 flex flex--col flex--center gap--none">
            {% if card.status == 'weekend' %}<span class="label label--small {% if profile == 'full' %}lg:label--base{% endif %} text--bold text-stroke text-stroke--medium text-stroke--white">OH</span><span class="label label--small {% if profile == 'full' %}lg:label--base{% endif %} text--bold text-stroke text-stroke--medium text-stroke--white">NO</span>
            {% elsif card.status == 'day' %}<span class="label label--small text--bold text-stroke text-stroke--medium text-stroke--white">DAY</span><span class="label label--small text--bold text-stroke text-stroke--medium text-stroke--white">OFF</span>
            {% else %}<span class="label label--small text--bold {% if paid_pto %}text--white{% else %}text-stroke text-stroke--medium text-stroke--white{% endif %}">USE</span><span class="value value--xsmall {% if profile == 'full' %}lg:value--base{% elsif profile == 'column' %}lg:value--xsmall{% else %}lg:value--small{% endif %} text--bold {% if paid_pto %}text--white{% else %}text-stroke text-stroke--large text-stroke--white{% endif %}">{{ card.leave_cost }}{% unless profile == 'column' %}<span class="label label--small text--regular {% if paid_pto %}text--white{% else %}text-stroke text-stroke--medium text-stroke--white{% endif %}">&nbsp;{% if card.leave_cost == 1 %}day{% else %}days{% endif %}</span>{% endunless %}</span>{% if profile == 'column' %}<span class="label label--small {% if paid_pto %}text--white{% else %}text-stroke text-stroke--medium text-stroke--white{% endif %}">{% if card.leave_cost == 1 %}day{% else %}days{% endif %}</span>{% endif %}{% endif %}
          </div>
          <div class="col--span-8 flex flex--col flex--left flex--center-y gap--none pr--1 {% if profile == 'column' %}py--1{% endif %}">
            <span class="label label--small {% if profile == 'full' and card.title.size <= 48 %}lg:label--large{% elsif profile == 'column' and ticket_action_size > 40 %}lg:label--small{% else %}lg:label--base{% endif %} pto-ticket-heading text--regular w--full"><span class="text--bold">{{ card.title | escape }}</span> &middot; <span class="pto-ticket-countdown text--regular">{{ card.countdown_label | escape }}</span></span>
            {% if card.status == 'available' %}<span class="label label--small {% if profile == 'full' %}lg:label--base{% else %}lg:label--small{% endif %} text--regular w--full">{% if card.leave_cost == 0 %}No leave needed{% else %}Take {{ card.request_label | escape }}{% endif %} &rarr; {{ card.break_label | escape }} Off</span>
            {% else %}<span class="label label--small text--regular w--full">{{ card.weekend_line | escape }}</span>{% endif %}
          </div>
          <div class="col--span-2 flex flex--col flex--center gap--none">
            <span class="value value--xsmall {% if profile == 'full' %}lg:value--base{% elsif profile == 'column' %}lg:value--xsmall{% else %}lg:value--small{% endif %} text--bold">{{ card.total_days }}</span><span class="label label--small text--center">{% if profile == 'column' %}{% if card.status == 'weekend' %}extra{% elsif card.total_days == 1 %}day{% else %}days{% endif %}<br>{% if card.status == 'weekend' %}days{% else %}off{% endif %}{% else %}{% if card.status == 'weekend' %}extra days{% elsif card.total_days == 1 %}day off{% else %}days off{% endif %}{% endif %}</span>
          </div>
        </div>
      </div>
    {% endfor %}
    {% if tickets.size == 0 %}<span class="label label--small">{% if status == 'partial' %}Waiting for more published dates.{% else %}No upcoming national dates listed.{% endif %}</span>{% endif %}
  </div>
{% endtemplate %}
{% template pto_footer %}
<div class="title_bar">
